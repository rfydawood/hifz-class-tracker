rules_version = '2';

// Data model: one document per class, keyed by a random "class code" the
// teacher generates in the app (see index.html's cloud-sync code). There is
// no password check beyond the code itself - the code IS the secret, like an
// unguessable link. Anyone who is signed in (anonymous auth is enough) and
// knows the exact code can read/write that one document. Codes are never
// listable, so they can't be discovered by browsing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /classes/{classCode} {
      allow get: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['profileJSON', 'dayJSON', 'updatedAt'])
        && (!('profileJSON' in request.resource.data) ||
            (request.resource.data.profileJSON is string && request.resource.data.profileJSON.size() < 500000))
        && (!('dayJSON' in request.resource.data) ||
            (request.resource.data.dayJSON is string && request.resource.data.dayJSON.size() < 500000));

      // Class codes can never be listed or deleted through the client.
      allow list, delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
