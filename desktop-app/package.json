{
  "name": "hifz-class-tracker-desktop",
  "productName": "Hifz Class Tracker",
  "version": "1.0.1",
  "description": "Hifz Class Tracker for desktop",
  "author": "Hifz Class Tracker",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.hifztracker.desktop",
    "productName": "Hifz Class Tracker",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Hifz-Class-Tracker-Setup.${ext}",
      "shortcutName": "Hifz Class Tracker"
    },
    "publish": {
      "provider": "github",
      "owner": "rfydawood",
      "repo": "hifz-class-tracker-desktop",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@44.9.2": true
  }
}
